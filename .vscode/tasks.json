{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "PixelRPG: Build",
            "type": "shell",
            "command": "gradle",
            "args": [
                "clean",
                "build",
                "--no-daemon"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gradle"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "PixelRPG: ShadowJar",
            "type": "shell",
            "command": "gradle",
            "args": [
                "shadowJar",
                "--no-daemon"
            ],
            "group": "build",
            "problemMatcher": ["$gradle"],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
